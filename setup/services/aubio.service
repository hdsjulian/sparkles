[Unit]
Description=Sparkles Aubio Pitch Detector
After=sparkles.service sound.target
Requires=sparkles.service

[Service]
Type=simple
User=julian
WorkingDirectory=/home/julian/sparkles/pitchdetector
ExecStart=/home/julian/myenv/bin/python3 aubioAlgo.py
Restart=always
RestartSec=5
Environment=JACK_NO_START_SERVER=1
# Which input to listen on: an index, or any part of the device name.
# Matching by name survives the card renumbering that a reboot or a
# replugged interface causes. If the named device is absent it falls back
# to the first input, so this is safe to set before the hardware arrives.
Environment=SPARKLES_AUDIO_DEVICE=Scarlett
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
