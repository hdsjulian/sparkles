[Unit]
Description=Sparkles Aubio Pitch Detector
After=sparkles.service sound.target
Requires=sparkles.service

[Service]
Type=simple
User=julian
WorkingDirectory=/home/julian/sparkles/pitchdetector
ExecStart=/home/julian/myenv/bin/python3 aubioAlgo.py
Restart=always
RestartSec=5
Environment=JACK_NO_START_SERVER=1
# The input is chosen automatically: interfaces and USB microphones score
# above the pi's own pseudo-devices, so plugging an interface in is enough.
# SPARKLES_AUDIO_DEVICE=<index or name> overrides it, SPARKLES_AUTO_LEVEL=0
# keeps the thresholds from the UI instead of deriving them from the room.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
