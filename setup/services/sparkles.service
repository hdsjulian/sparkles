[Unit]
Description=Sparkles FastAPI Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=julian
WorkingDirectory=/home/julian/sparkles/sparkles-api
ExecStart=/home/julian/myenv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
Environment=SPARKLES_PORT_GLOB=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*
Environment=SPARKLES_SONGS_DIR=/home/julian/sparkles/songs
Environment=SPARKLES_SERIAL_LOG=/home/julian/sparkles/logs/serial.log
Environment=PIO_BIN=/home/julian/myenv/bin/pio
Environment=SPARKLES_MESH_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B21228979-if00
Environment=SPARKLES_MESH_BIN=/home/julian/myenv/bin/meshtastic
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
